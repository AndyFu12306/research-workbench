# Proposed Workbench configuration; no application reads this file yet.
# Public loopback address only. Phase 1 requires no API key.
WORKBENCH_ZOTERO_BASE_URL=http://127.0.0.1:23119/api
WORKBENCH_ZOTERO_TIMEOUT_SECONDS=5

# Upstream local mode; explicitly export into the CLI process when testing.
# Copying this file alone does not guarantee that an external CLI loads it.
ZOTERO_LOCAL=true

# Explicit API backend used by the spike; export both for a new CLI process.
ZOTERO_BACKEND=api
ZOTERO_SEARCH_BACKEND=api
