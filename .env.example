# No automatic .env loader. Export these variables before starting Python.
# Workbench-owned SQLite only; relative paths resolve from the startup working directory.
WORKBENCH_DATABASE_PATH=data/research_workbench.db

# Leave blank for shutil.which() discovery; otherwise use an absolute native executable.
ZOTERO_CLI_PATH=

# Integration tests only. Use existing local data, never create test Zotero items.
ZOTERO_TEST_QUERY=agent
ZOTERO_TEST_ITEM_KEY=
ZOTERO_TEST_ANNOTATED_ITEM_KEY=

# Local mode and API backend are enforced by ZoteroClient, not user-selectable here.
# No Web API key or local write credential is needed.

# Explicit OpenAI provider only. No .env auto-loading and no default model.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60

# Paid integration tests only; explicit marker is also required.
RUN_OPENAI_INTEGRATION=0

# DeepSeek provider: explicit configuration, no .env auto-loading.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=
RUN_DEEPSEEK_INTEGRATION=0
# Separate consent for sending the explicitly selected Zotero abstract.
RUN_DEEPSEEK_ZOTERO_E2E=0
